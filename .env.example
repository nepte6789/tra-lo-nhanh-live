# Sao chép thành .env ở cùng thư mục package.json. Không đưa API key lên GitHub.
PORT=3000
# Kênh TikTok đang LIVE: @username hoặc https://www.tiktok.com/@username/live
TIKTOK_CHANNEL=
# Khóa EulerStream của bạn nếu dịch vụ ký yêu cầu. SIGN_API_KEY cũ vẫn dùng được.
EULERSTREAM_API_KEY=
# Mặc định chỉ nhận trên máy chạy; giữ cấu hình này nếu không cần mạng LAN.
HOST=127.0.0.1
# OPEN_BROWSER=1 để tự mở bảng điều khiển sau khi server sẵn sàng.
OPEN_BROWSER=0
